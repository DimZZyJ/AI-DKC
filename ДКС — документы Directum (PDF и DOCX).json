{
  "name": "ДКС — документы Directum (PDF и DOCX)",
  "nodes": [
    {
      "parameters": {
        "options": {
          "allowFileUploads": true,
          "allowedFilesMimeTypes": ".pdf,.docx,.txt,.csv,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv",
          "responseMode": "lastNode"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "id": "7e66aacd-615f-47c1-a1eb-17f423b9a490",
      "name": "When chat message received",
      "webhookId": "1f4f129e-e726-4ca9-a4fb-6799a80784e9",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first();\nconst files = [];\nfor (const [key, file] of Object.entries(input.binary || {})) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, key);\n  if (buffer.length > 25 * 1024 * 1024) throw new Error('Файл больше 25 МБ. Разделите его на части.');\n  files.push({name: file.fileName || key, data: buffer.toString('base64')});\n}\nif (files.length > 10) throw new Error('За один раз можно загрузить до 10 файлов.');\nreturn [{json: {sessionId: input.json.sessionId, chatInput: input.json.chatInput || '', files}}];"
      },
      "id": "cbfe914a-306d-4813-b53c-f1fd3dddf98d",
      "name": "Подготовка всех вложений",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://dkc-ai-documents:8080/prepare",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 1800000
        }
      },
      "id": "a1f7be4c-31d6-4e19-a598-ec8ca7928b71",
      "name": "Чтение OCR и поиск",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        496,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "e14c15c9-b7f3-487b-9976-c8215be34c28",
              "leftValue": "={{ $json.needsAnswer }}",
              "rightValue": "",
              "operator": {
